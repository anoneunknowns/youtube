    {
      "id": "T008a",
      "path": "T008a.wav",
      "spoken_text": "Let's look inside that addition. In the ones column, eight plus three makes eleven: one stays here, and one ten moves left.",
      "duration_s": 7.560125,
      "sha256": "41ea6bb5409b09c5fba7411b93b4a27fe5599f66bd148137846485a2d4c2adb2"
    },
    {
      "id": "T008b",
      "path": "T008b.wav",
      "spoken_text": "That carried ten joins the ten already there. The columns now show two tens and one one. Then the newest pair moves on.",
      "duration_s": 7.438916666666667,
      "sha256": "2b60a03986a86747fcb6854f1f113382241ef685ee550d6861caf60946743a38"
    },
