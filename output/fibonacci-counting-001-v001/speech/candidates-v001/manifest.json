    {
      "id": "T018a",
      "path": "T018a.wav",
      "spoken_text": "Now the values reach into the thousands. Start at the ones and follow each carry to the next column, one place at a time.",
      "duration_s": 7.0320833333333335,
      "sha256": "428d46ed49837b4f086713fbbcc3fc3bfca9906b101779d40e86297016e4fe95"
    },
    {
      "id": "T018b",
      "path": "T018b.wav",
      "spoken_text": "Seven plus seven makes fourteen. Next come eighteen tens, then fifteen hundreds. Each carry moves one column left; it never skips a place.",
      "duration_s": 8.8435,
      "sha256": "3ea0f80bb1a23e5cd0a3b96e5b9c0725f08bf5f98c6ecfba4635e8fa1d14e84b"
