{"id":"T013a","text":"Here the ones make thirteen. Write three and carry one ten. The tens, including that carry, also make thirteen.","path":"/Users/support/codex/youtube/output/fibonacci-counting-001-v001/speech/candidates-v001/T013a.wav","duration_s":6.876916666666666,"sha256":"652e829291f560edbf61088053f1f305ceb534f4167b921c20fbfb86b0dcddda","trim":{"raw_duration_s":7.6,"leading_s":0.26329166666666665,"trailing_s":0.45979166666666665,"peak_normalization_gain":1},"generation":{"provider":"local-kokoro","model_id":"onnx-community/Kokoro-82M-v1.0-ONNX","voice_id":"af_heart","speed":0.98,"dtype":"fp32","status":"unreviewed-candidate"}}
