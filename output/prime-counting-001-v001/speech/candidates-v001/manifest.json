{
  "schema_version": 1,
  "measurement_status": "measured",
  "numbers": [],
  "dialogue": [
    {
      "id": "I01",
      "path": "I01.wav",
      "spoken_text": "Hi! Let's count prime numbers.",
      "duration_s": 1.7335416666666668,
      "sha256": "552c66a9749ab639cdd78d470c5dbea7ea520afea99ec20089f5627eabd18b40"
    },
    {
      "id": "I02",
      "path": "I02.wav",
      "spoken_text": "A prime number is a whole number greater than one with exactly two positive factors: one and itself.",
      "duration_s": 6.050791666666667,
      "sha256": "29dd81f6b0572004f3c9de74c7e205f92503b7f8ac812d3c2076f69918ac05d5"
    },
    {
      "id": "I03",
      "path": "I03.wav",
      "spoken_text": "A factor divides a number evenly, with nothing left over.",
      "duration_s": 3.453375,
      "sha256": "110e9db09bf84ff3ee7d5c618a0ddf496013e12e9b66399d00900bf759357435"
    },
    {
      "id": "I04",
      "path": "I04.wav",
      "spoken_text": "Let's try five tiles.",
      "duration_s": 1.4194583333333333,
      "sha256": "50613c1e760f6cd7d5d7f975429e90dec54e66f7684d7bb8b983cda80f9c6a0e"
    },
    {
      "id": "I05",
      "path": "I05.wav",
      "spoken_text": "Five makes one row of five. Its only factors are one and five.",
      "duration_s": 4.0084583333333335,
      "sha256": "8c91007b251316cd6eaa91394db98514848068e8f29fb04168f14f37e8efc399"
    },
    {
      "id": "I06",
      "path": "I06.wav",
      "spoken_text": "Six also makes two rows of three. Six has more than two factors, so it is not prime.",
      "duration_s": 5.405666666666667,
      "sha256": "5bc1e3ce4fd6a2579e247ff3af06f27326279899f891a88b730f8aeec062420e"
    },
    {
      "id": "I07",
      "path": "I07.wav",
      "spoken_text": "Turning a rectangle around does not give us new factors.",
      "duration_s": 3.2474583333333333,
      "sha256": "2152da6eb3d39ea04e62bbc4f6c9a9fafecd13c3516bd41a7915c7effbf23b64"
    },
    {
      "id": "I08",
      "path": "I08.wav",
      "spoken_text": "One has only one factor: one. So one is not prime.",
      "duration_s": 3.3004166666666666,
      "sha256": "a6d2920fa8730f20567c52afed62c4843b858feafa5ce6af3c0b9cd8b469151e"
    },
    {
      "id": "I09",
      "path": "I09.wav",
      "spoken_text": "Now let's count every prime number below one thousand.",
      "duration_s": 2.986458333333333,
      "sha256": "0b210bd3c04ad8ad53903d7d357f7face982377ed93f1448bb112c30882d8371"
    },
    {
      "id": "T002a",
      "path": "T002a.wav",
      "spoken_text": "Two has exactly two factors: one and two.",
      "duration_s": 2.49275,
      "sha256": "ea0ba3afb3286fddcf333199529e51d8e20a4c0e0eca8d316488e2a771c62df4"
    },
    {
      "id": "T002b",
      "path": "T002b.wav",
      "spoken_text": "Any larger even number has two as another factor.",
      "duration_s": 2.86725,
      "sha256": "17a97782de369cb3dddf3cb05cc964ff936c59771772d8913002dab7fc93feaf"
    },
    {
      "id": "T002c",
      "path": "T002c.wav",
      "spoken_text": "Two is the only even prime.",
      "duration_s": 1.6614166666666668,
      "sha256": "bf9d989a1cb3a1f481050eb85324b4b25e71c45ad50770048873472764fe7235"
    },
    {
      "id": "T009a",
      "path": "T009a.wav",
      "spoken_text": "Nine is odd, but three rows of three make nine.",
      "duration_s": 2.8619166666666667,
      "sha256": "a3fd146f95286081a9130cbed42112453684c56c02a22708f90291e26662d030"
    },
    {
      "id": "T009b",
      "path": "T009b.wav",
      "spoken_text": "Nine has factors other than one and itself. It is not prime.",
      "duration_s": 3.5889166666666665,
      "sha256": "f82d2d084d41545f8844b1c78328c85dad56c96e51f214f12611e850279d6b10"
    },
    {
      "id": "T101a",
      "path": "T101a.wav",
      "spoken_text": "Ninety-eight, ninety-nine, and one hundred have extra factors.",
      "duration_s": 3.5923333333333334,
      "sha256": "cf83b8321fc6715dd62f581908f3d41600c136f0ac0c1b9298d051b17a55f324"
    },
    {
      "id": "T101b",
      "path": "T101b.wav",
      "spoken_text": "The next prime after ninety-seven is one hundred one.",
      "duration_s": 3.0007916666666667,
      "sha256": "6fc7bdebc1dab93794280cb0acd2e84787d39b6fde5bdb718d353f10d82c2307"
    },
