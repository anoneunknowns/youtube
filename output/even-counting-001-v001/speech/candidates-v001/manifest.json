{
  "schema_version": 1,
  "measurement_status": "measured",
  "numbers": [],
  "dialogue": [
    {
      "id": "I01",
      "path": "I01.wav",
      "spoken_text": "Hi! Let's count even numbers.",
      "duration_s": 1.8090833333333334,
      "sha256": "d9ab3df198cd01c7b71f499ddb06597e95c60fea6750a0fa58c80f94f32ddef4"
    },
    {
      "id": "I02",
      "path": "I02.wav",
      "spoken_text": "We add two each time.",
      "duration_s": 1.27325,
      "sha256": "85bddffdcce929f1770f5306138fc5f5a75e684b7e6432df101e0b87e64f9460"
    },
    {
      "id": "I03",
      "path": "I03.wav",
      "spoken_text": "Two blocks make one pair.",
      "duration_s": 1.4382916666666667,
      "sha256": "7639fbd9332426f59a96498c42d87270dc7ef30147e95c667e1eaa04865e60a0"
    },
    {
      "id": "I04",
      "path": "I04.wav",
      "spoken_text": "Six blocks make three pairs, with none left over.",
      "duration_s": 2.893291666666667,
      "sha256": "ae1aee8e1b9a11b4229a91417898688aa838f271b9721ae4d49f495673a2a9ac"
    },
    {
      "id": "I05",
      "path": "I05.wav",
      "spoken_text": "Even numbers can be grouped in pairs.",
      "duration_s": 1.9970416666666666,
      "sha256": "42aa137daa0c8600d0e975c374b58d6ca6ff487c18b6e36b3d8f77d7fa94f2f3"
    },
    {
      "id": "I06",
      "path": "I06.wav",
      "spoken_text": "Zero is even too.",
      "duration_s": 1.2365416666666667,
      "sha256": "b98c080c622d34ce84284c23b60540e24c2d530ef0b96dbe8d0f48ab950bfb75"
    },
    {
      "id": "I06B",
      "path": "I06B.wav",
      "spoken_text": "There are no blocks left over.",
      "duration_s": 1.5400833333333332,
      "sha256": "7e16294cb8926dddaca6408674d26c9af9c5ee7f92118e808297d42b95bbb119"
    },
    {
      "id": "I07",
      "path": "I07.wav",
      "spoken_text": "Let's count from zero to two hundred.",
      "duration_s": 1.903875,
      "sha256": "328fb49387753f8eff8e065bd7a837761894713429b25370d740f65ed7352e6b"
    },
    {
      "id": "T020",
      "path": "T020.wav",
      "spoken_text": "Twenty blocks make ten pairs, with none left over.",
      "duration_s": 2.9987083333333335,
      "sha256": "123e25b659cfbd48c5f89e0fd641c0359f68c13bfa65450d41057b49ed5e648e"
    },
    {
      "id": "T100",
      "path": "T100.wav",
      "spoken_text": "The last digit is always zero, two, four, six, or eight.",
      "duration_s": 3.5252083333333335,
      "sha256": "28fab785f07e3257c104ff65507b6df34f45aa41188e084e69ccf6a85bdb6448"
    },
    {
      "id": "F02",
      "path": "F02.wav",
      "spoken_text": "We counted by twos, all the way to two hundred!",
      "duration_s": 2.7259166666666665,
      "sha256": "b2afdc02e0fbea7dd6215f4adfb054f75c2a7166648482eb88e899d2b2df117b"
    }
  ]
}
