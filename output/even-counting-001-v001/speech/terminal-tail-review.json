    "entries": [
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Hi! Let's count even numbers.",
        "phonemes": "hˈaɪ lˈɛts kˈaʊnt ˈiːvən nˈʌmbɚz",
        "terminal_phoneme": "z",
        "target_voiceless_terminal": false,
        "duration_s": 1.8090833333333334,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I01.wav",
        "sha256": "d9ab3df198cd01c7b71f499ddb06597e95c60fea6750a0fa58c80f94f32ddef4"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "We add two each time.",
        "phonemes": "wiː ˈæd tˈuː ˈiːtʃ tˈaɪm",
        "terminal_phoneme": "m",
        "target_voiceless_terminal": false,
        "duration_s": 1.27325,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I02.wav",
        "sha256": "85bddffdcce929f1770f5306138fc5f5a75e684b7e6432df101e0b87e64f9460"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Two blocks make one pair.",
        "phonemes": "tˈuː blˈɑːks mˌeɪk wˈʌn pˈɛɹ",
        "terminal_phoneme": "ɹ",
        "target_voiceless_terminal": false,
        "duration_s": 1.4382916666666667,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I03.wav",
        "sha256": "7639fbd9332426f59a96498c42d87270dc7ef30147e95c667e1eaa04865e60a0"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Six blocks make three pairs, with none left over.",
        "phonemes": "sˈɪks blˈɑːks mˌeɪk θɹˈiː pˈɛɹz wɪð nˈʌn lˈɛft ˈoʊvɚ",
        "terminal_phoneme": "ɚ",
        "target_voiceless_terminal": false,
        "duration_s": 2.893291666666667,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I04.wav",
        "sha256": "ae1aee8e1b9a11b4229a91417898688aa838f271b9721ae4d49f495673a2a9ac"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Even numbers can be grouped in pairs.",
        "phonemes": "ˈiːvən nˈʌmbɚz kæn biː ɡɹˈuːpt ɪn pˈɛɹz",
        "terminal_phoneme": "z",
        "target_voiceless_terminal": false,
        "duration_s": 1.9970416666666666,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I05.wav",
        "sha256": "42aa137daa0c8600d0e975c374b58d6ca6ff487c18b6e36b3d8f77d7fa94f2f3"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Zero is even too.",
        "phonemes": "zˈiəɹoʊ ɪz ˈiːvən tˈuː",
        "terminal_phoneme": "ː",
        "target_voiceless_terminal": false,
        "duration_s": 1.2365416666666667,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I06.wav",
        "sha256": "b98c080c622d34ce84284c23b60540e24c2d530ef0b96dbe8d0f48ab950bfb75"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "There are no blocks left over.",
        "phonemes": "ðɛɹˌɑːɹ nˈoʊ blˈɑːks lˈɛft ˈoʊvɚ",
        "terminal_phoneme": "ɚ",
        "target_voiceless_terminal": false,
        "duration_s": 1.5400833333333332,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I06B.wav",
        "sha256": "7e16294cb8926dddaca6408674d26c9af9c5ee7f92118e808297d42b95bbb119"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Let's count from zero to two hundred.",
        "phonemes": "lˈɛts kˈaʊnt fɹʌm zˈiəɹoʊ tə tˈuː hˈʌndɹɪd",
        "terminal_phoneme": "d",
        "target_voiceless_terminal": false,
        "duration_s": 1.903875,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\I07.wav",
        "sha256": "328fb49387753f8eff8e065bd7a837761894713429b25370d740f65ed7352e6b"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Twenty blocks make ten pairs, with none left over.",
        "phonemes": "twˈɛnti blˈɑːks mˌeɪk tˈɛn pˈɛɹz wɪð nˈʌn lˈɛft ˈoʊvɚ",
        "terminal_phoneme": "ɚ",
        "target_voiceless_terminal": false,
        "duration_s": 2.9987083333333335,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\T020.wav",
        "sha256": "123e25b659cfbd48c5f89e0fd641c0359f68c13bfa65450d41057b49ed5e648e"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "The last digit is always zero, two, four, six, or eight.",
        "phonemes": "ðə lˈæst dˈɪdʒɪt ɪz ˈɔːlweɪz zˈiəɹoʊ tˈuː fˈoːɹ sˈɪks ɔːɹ ˈeɪt",
        "terminal_phoneme": "t",
        "target_voiceless_terminal": true,
        "duration_s": 3.5252083333333335,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\T100.wav",
        "sha256": "28fab785f07e3257c104ff65507b6df34f45aa41188e084e69ccf6a85bdb6448"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "We did it!",
        "phonemes": "wiː dˈɪd ɪt",
        "terminal_phoneme": "t",
        "target_voiceless_terminal": true,
        "duration_s": 0.7225416666666666,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\reused\\F01.wav",
        "sha256": "f78e95f408a0f08bc7b866d11768c833188076fee0958c55d027742fed417d54"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "We counted by twos, all the way to two hundred!",
        "phonemes": "wiː kˈaʊntᵻd baɪ tˈuːz ˈɔːl ðə wˈeɪ tə tˈuː hˈʌndɹɪd",
        "terminal_phoneme": "d",
        "target_voiceless_terminal": false,
        "duration_s": 2.7259166666666665,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\candidates-v001\\F02.wav",
        "sha256": "b2afdc02e0fbea7dd6215f4adfb054f75c2a7166648482eb88e899d2b2df117b"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Thanks for counting with me!",
        "phonemes": "θˈæŋks fɔːɹ kˈaʊntɪŋ wɪð mˌiː",
        "terminal_phoneme": "ː",
        "target_voiceless_terminal": false,
        "duration_s": 1.377875,
        "path": "D:\\codex_projects\\youtube\\output\\even-counting-001-v001\\speech\\reused\\F03.wav",
        "sha256": "62cb04c29b372d52949d85bce55772ae4e813ff26c118ae6895fd344edc01296"
      },
      {
        "role": "dialogue",
        "number": null,
        "spoken_text": "Bye for now!",
        "phonemes": "bˈaɪ fɔːɹ nˈaʊ",
        "terminal_phoneme": "ʊ",
        "target_voiceless_terminal": false,
        "duration_s": 0.8331666666666667,
