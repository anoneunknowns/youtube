    "generation": {
      "provider": "local-kokoro",
      "model_id": "onnx-community/Kokoro-82M-v1.0-ONNX",
      "voice_id": "af_heart",
      "speed": 0.98,
      "dtype": "fp32",
      "status": "unreviewed-candidate"
    }
  },
  {
    "id": "I05",
    "text": "These mirrors show number values, not amounts of water. Three copies mean three times the value.",
    "path": "/Users/support/codex/youtube/output/collatz-counting-001-v001/speech/candidates-v001/I05.wav",
    "duration_s": 5.790625,
    "sha256": "e79dd1d447c7e28a6ba85792059554281734d8b973c196ff78561747c70a4aca",
