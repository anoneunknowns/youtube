[
  {
    "id": "I01",
    "text": "Hi! Follow the Collatz sequence through our number waterworks.",
    "path": "/Users/support/codex/youtube/output/collatz-counting-001-v001/speech/candidates-v001/I01.wav",
    "duration_s": 3.201625,
