  "findings": [
    {
      "id": "NATIVE-01",
      "priority": "medium",
      "status": "needs-improvement",
      "title": "Unintended whole-head/body step during hand gestures",
      "observed": "Neutral ear-top y550 becomes y565 in wave_raise/high/left/right/settle; think_raise reaches y567 then think returns to y551. On the actual encoded contact, torso and tail contour also change when the paw alone should raise. Feet remain at the common ground root, so this is artwork proportion/pose mismatch rather than translation timing.",
      "comparison": "The decoded Bear wave sweeps the arm with a steadier head/body silhouette; a 15–17px single-cut shift is more conspicuous in the small 430px kangaroo.",
      "recommendation": "Generate/revise gesture and thought transition art against the exact adopted v002 neutral body/head, or generate isolated arm drawings for a fixed-body composite. Preserve common sheet physical scaling and foot roots; do not hide the mismatch with per-pose bbox fitting or whole-character dissolves.",
      "evidence": [
        "prime-opening-wave-contact.jpg",
        "prime-factor-thinking-contact.jpg",
        "source-head-transition.png",
        "geometry-observations.json",
        "bear-opening-wave-contact.jpg"
      ]
    },
    {
      "id": "NATIVE-02",
      "priority": "medium",
      "status": "repertoire-gap",
      "title": "No sustained seated/rest/stretch state in the longer film",
      "observed": "The v002 actor repertoire has 18 registered keys including two neutral drawings, blink halves/closed, arm-transition intermediates and jump phases. There is no seated rest, stretch or clap in the actual acting schedule. The Bear completed film visibly sits, stretches, rests, then stands at its 200-count break.",
      "recommendation": "A quiet seated or stretch passage, with genuine sit/stand intermediates, would give the long count a distinct silhouette and help match the older performance variety. Use narrative-appropriate existing stock if visually coherent; generate missing neutral-compatible intermediates if it is not. No need to add unrelated props or constant bobbing.",
      "evidence": [
        "bear-seated-stretch-contact.jpg",
        "prime-halfway-hop-contact.jpg"
      ]
    }
  ],
  "adequate_existing_material": [
    {
      "keys": [
        "blink_half",
        "blink_closed",
        "smile_open"
      ],
      "assessment": "Actual open→half→closed→half→open frames show clean eyes, no residual open-eye ghost and stable face/body drawing. Keep this rig; no regeneration indicated.",
      "evidence": "prime-blink-contact.png"
    },
    {
      "keys": [
        "posture_neutral",
        "crouch_half",
        "crouch_down",
        "takeoff",
        "hop_air",
        "land"
      ],
      "assessment": "Crouch, extension, tucked airborne pose and bent landing are anatomically legible in actual decoded frames. Tail/ears remain complete and no duplicated limbs are visible. Keep these drawings unless new scene staging exposes a new issue.",
      "evidence": "prime-halfway-hop-contact.jpg"
    },
    {
      "keys": [
        "wave_raise",
        "wave_high",
        "wave_left",
        "wave_right"
      ],
      "assessment": "The existing wave does read as a greeting, and is not static. Its main defect is whole-body/head continuity on entry/exit, not lack of any arm displacement. Three strong arm positions are visible; wave_right is close to the low intermediate, so do not claim four equally distinct palm angles.",
      "evidence": "prime-opening-wave-contact.jpg"
    }
  ],
  "composition_note": "Prime character is smaller than the Bear (430px versus themed606px natural scale), but it has a different teaching-board layout. Matching absolute body height is not itself necessary; preserve legibility and clear teaching fields.",
