[
  {
    "id": "I01",
    "kind": "intro",
    "scene_id": "title",
    "text": "Hi! Let's count prime numbers.",
    "translation_ja": "こんにちは。素数を数えよう。",
    "planning_window_seconds": [
      0.8,
      4.5
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I02",
    "kind": "intro",
    "scene_id": "definition",
    "text": "A prime number is a whole number greater than one with exactly two positive factors: one and itself.",
    "translation_ja": "素数は1より大きい整数で、約数が1とその数自身のちょうど二つだけある数だよ。",
    "planning_window_seconds": [
      5.2,
      14.2
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I03",
    "kind": "intro",
    "scene_id": "definition",
    "text": "A factor divides a number evenly, with nothing left over.",
    "translation_ja": "約数は、その数を余りなく割り切れる数だよ。",
    "planning_window_seconds": [
      15.0,
      21.2
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I04",
    "kind": "intro",
    "scene_id": "arrays-5-vs-6",
    "text": "Let's try five tiles.",
    "translation_ja": "タイル5枚で試してみよう。",
    "planning_window_seconds": [
      22.0,
      25.2
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I05",
    "kind": "intro",
    "scene_id": "arrays-5-vs-6",
    "text": "Five makes one row of five. Its only factors are one and five.",
    "translation_ja": "5枚は1行に5枚。約数は1と5だけだよ。",
    "planning_window_seconds": [
      26.0,
      34.2
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I06",
    "kind": "intro",
    "scene_id": "arrays-5-vs-6",
    "text": "Six also makes two rows of three. Six has more than two factors, so it is not prime.",
    "translation_ja": "6枚は2行に3枚ずつも並べられるよ。約数が二つより多いから、素数ではないね。",
    "planning_window_seconds": [
      35.0,
      44.8
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I07",
    "kind": "intro",
    "scene_id": "arrays-5-vs-6",
    "text": "Turning a rectangle around does not give us new factors.",
    "translation_ja": "長方形を回しても、新しい約数が増えるわけではないよ。",
    "planning_window_seconds": [
      45.6,
      51.8
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I08",
    "kind": "intro",
    "scene_id": "one-excluded",
    "text": "One has only one factor: one. So one is not prime.",
    "translation_ja": "1の約数は1の一つだけ。だから1は素数ではないよ。",
    "planning_window_seconds": [
      52.6,
      60.0
    ],
    "time_reference": "intro_start",
    "timing_status": "provisional_not_audio_measured"
  },
  {
    "id": "I09",
